<bblocks://ogc.sosa.properties.system> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "SOSA System" ;
    dct:abstract "System is a unit of abstraction for pieces of infrastructure that implement Procedures. A System may have components (implemented as subsystems), and may be deployed at a Platform. Sensor, Actuator and Sampler are all types of System."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2024-01-01T00:00:00+00:00"^^xsd:dateTime ;
