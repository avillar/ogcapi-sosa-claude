<bblocks://ogc.sosa.properties.featureOfInterest> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "SOSA FeatureOfInterest" ;
    dct:abstract "The thing whose property is being observed or acted upon. A feature of interest is an abstraction of a real-world phenomenon to which a property being observed, or acted on by an actuator, or sampled, belongs."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2024-01-01T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "text/html" ;
            rdfs:isDefinedBy <https://avillar.github.io/ogcapi-sosa-claude/bblock/ogc.sosa.properties.featureOfInterest> ],
