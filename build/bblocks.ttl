<bblocks://ogc.sosa.properties.execution> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "SOSA Execution" ;
    dct:abstract "An act of carrying out a Procedure by a System on or about a FeatureOfInterest, with the objective of producing a Result. Execution is the common abstract class for Observation, Actuation and Sampling."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2024-01-01T00:00:00+00:00"^^xsd:dateTime ;
