<bblocks://ogc.sosa.properties.property> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "SOSA Property" ;
    dct:abstract "An identifiable quality (property, characteristic) of a FeatureOfInterest. A Property can be associated with different Features of Interest, may be observed by a Procedure, and can be acted upon by an Actuator. ObservableProperty, ActuatableProperty, and SampledProperty are all types of Property."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2024-01-01T00:00:00+00:00"^^xsd:dateTime ;
